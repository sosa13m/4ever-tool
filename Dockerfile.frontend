FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci --no-audit --no-fund
COPY . .
# Public address of the site, used for the share image in link previews.
ARG VITE_SITE_URL=
ENV VITE_SITE_URL=$VITE_SITE_URL
RUN npm run build

FROM nginx:1.27-alpine
# Where the API lives (Docker Compose service name by default) and which
# proxy may tell us the real client IP. Override on other platforms.
ENV API_UPSTREAM=http://api:8000 \
    TRUSTED_PROXY_CIDR=127.0.0.1
COPY nginx.conf /etc/nginx/templates/default.conf.template
COPY deploy/4ever-security.conf deploy/4ever-proxy.conf /etc/nginx/
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
