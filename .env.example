# --- Converter limits ---
MAX_SOURCE_BYTES=262144000
FILE_TTL_SECONDS=3600
MAX_CONCURRENT_JOBS=2
MAX_CONCURRENT_DOWNLOADS=2
MAX_ACTIVE_JOBS_PER_CLIENT=2
MAX_REDIRECTS=5

# --- Abuse protection ---
MAX_QUEUED_JOBS=40
MIN_FREE_DISK_MB=1024

RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
# true ONLY when the API sits behind the bundled nginx (docker-compose.prod.yml).
# If the API is exposed directly, keep false or anyone can spoof their IP.
TRUST_PROXY_HEADERS=false

# --- YouTube (yt-dlp) ---
YTDLP_ENABLED=true
# If set, YouTube links require this key (share it only with the collective).
# Leave empty to allow YouTube links without a key.
YTDLP_ACCESS_KEY=
YTDLP_MAX_DURATION_SECONDS=1200
YTDLP_JS_RUNTIMES=deno,node

ALLOWED_ORIGINS=http://localhost:4173,http://localhost:5173
# API docs at /api/docs (handy locally; keep false in production)
ENABLE_API_DOCS=true
LOG_LEVEL=INFO
