# =====================================================================
# 4EVERTOOLS — configuración de PRODUCCIÓN
# 1. Copia este archivo como .env (en la misma carpeta):  cp env.production.example .env
# 2. Cambia DOMAIN y ALLOWED_ORIGINS.
# 3. Revisa con:  cd backend && python scripts/preflight.py ../.env
# Nunca subas tu .env a internet (ya está en .gitignore y .dockerignore).
# =====================================================================

# --- Tu dominio (sin https://). Caddy pide el certificado HTTPS solo. ---
DOMAIN=tu-dominio.com
ALLOWED_ORIGINS=https://tu-dominio.com

# --- YouTube ---
# Decisión del colectivo: YouTube ABIERTO para todos.
# Si algún día quieren cerrarlo, pongan aquí una clave de 12 caracteres o más.
YTDLP_ENABLED=true
YTDLP_ACCESS_KEY=
YTDLP_MAX_DURATION_SECONDS=1200
YTDLP_JS_RUNTIMES=deno,node

# --- Límites del conversor ---
MAX_SOURCE_BYTES=262144000
FILE_TTL_SECONDS=3600
MAX_CONCURRENT_JOBS=2
MAX_CONCURRENT_DOWNLOADS=2
MAX_ACTIVE_JOBS_PER_CLIENT=2
MAX_QUEUED_JOBS=40
MIN_FREE_DISK_MB=1024
MAX_REDIRECTS=5

# --- Protección contra abuso ---
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
# true porque la API solo se alcanza a través del nginx incluido.
TRUST_PROXY_HEADERS=true

# --- Producción ---
ENABLE_API_DOCS=false
LOG_LEVEL=INFO
